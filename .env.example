# Saans Environment Variables
# Copy to .env.local and fill in values. NEVER commit secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-001

# OpenAQ
OPENAQ_API_KEY=your-openaq-api-key

# Agent Kill Switches (set to "true" to disable)
KILL_ALL_AGENTS=false
KILL_AG01=false
KILL_AG02=false
KILL_NOTIFICATIONS=false

# Cost Controls
LLM_DAILY_COST_CAP_USD=50
LLM_PER_USER_DAILY_INPUT_TOKENS=5000
LLM_PER_USER_DAILY_OUTPUT_TOKENS=2000

# App Config
NEXT_PUBLIC_APP_URL=https://saans.app
DEFAULT_MORNING_BRIEFING_HOUR=6
DEFAULT_MORNING_BRIEFING_MINUTE=30
